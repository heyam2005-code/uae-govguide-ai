# Default: all local. No external LLM calls.
ENABLE_LLM=0
# To enable optional answer wording by an LLM, set ENABLE_LLM=1 and provide your own key locally.
# Do not commit .env or keys to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Stage 2: additional, explicitly opt-in cloud slot extraction (requires ENABLE_LLM=1 as well)
ALLOW_CLOUD_NLU=0

# Stage 3: explain follow-up questions using service-specific official RAG passages
# Only enable with explicit informed consent for sending non-sensitive messages to API.
ALLOW_CLOUD_EXPLANATIONS=0
